# --- Secrets ---
.env
.env.*
!.env.example

# --- Node ---
node_modules/
npm-debug.log*
package-lock.json.bak

# --- TS3AudioBot (downloaded by install.sh, not vendored here) ---
ts3audiobot/TS3AudioBot
