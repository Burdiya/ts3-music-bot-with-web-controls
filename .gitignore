# --- Music library (user's own files — not part of the source tree) ---
music/*
!music/.gitkeep

# --- Editor / dev cruft ---
*.bak
*.bak.*
*.save
*~
.DS_Store

# --- Logs / runtime ---
*.log
*.pid

# --- pm2 ---
.pm2/
