# Copy this file to .env and fill in real values:
#   cp .env.example .env

# --- Web controller login (required) ---
# Credentials for logging into the web UI at http://<server>:9090
WEB_USERNAME=
WEB_PASSWORD=

# --- TS3 ServerQuery (optional) ---
# Enables the "who's in the channel" panel by querying the TeamSpeak server
# directly. Leave TS3_QUERY_PASSWORD empty to disable this feature.
# This must match the [query] username/password in ts3audiobot/ts3audiobot.toml.
TS3_QUERY_USERNAME=serveradmin
TS3_QUERY_PASSWORD=

# --- Spotify/SoundCloud import bridge (optional) ---
# URL + API key for an external downloader service that resolves Spotify
# and SoundCloud links into playable files. Leave both empty to disable
# the "Import Link" feature in the web UI.
IMPORT_API_URL=
IMPORT_API_KEY=
